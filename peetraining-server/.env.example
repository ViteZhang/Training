# 环境变量示例：只放占位值，真实值不进仓库。本地不设置任何变量也能启动（全部走 mock）。
APP_ENV=local
HTTP_ADDR=:8080
SHUTDOWN_TIMEOUT=30s
MYSQL_DSN=training:training@tcp(127.0.0.1:3306)/training
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0
# 生产必须设置，至少 32 个字符
JWT_SECRET=

OSS_ENDPOINT=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

# 云服务：mock 或真实服务商（真实实现在对应任务卡里加）
SMS_PROVIDER=mock
SMS_SIGN_NAME=
SMS_TEMPLATE_CODE=
# mock / bailian / relay（relay：OpenAI 兼容的中转接口为主，配了百炼时中转出错自动改用百炼）
AI_PROVIDER=mock
BAILIAN_BASE_URL=
BAILIAN_API_KEY=
AI_ALT_BASE_URL=
AI_ALT_API_KEY=
# 百炼两档模型的默认名（主用模型待 T31 评测后定）
AI_MODEL_STRONG=qwen-max
AI_MODEL_CHEAP=qwen-plus
# 优先用高阶模型：便宜档能力也用 STRONG（省钱时设为 false）
AI_PREFER_STRONG=true
AI_RELAY_BASE_URL=
AI_RELAY_API_KEY=
AI_RELAY_MODEL_STRONG=gpt-5.5
AI_RELAY_MODEL_CHEAP=gpt-5.5
# 模型价格，元 / 百万 token（输入:输出），按平台当时的公开价填写；不填则成本记为 0（7.8 成本看板与评测的每千次成本都依赖它）
AI_PRICES=
OCR_PROVIDER=mock
ASR_PROVIDER=mock
MODERATION_PROVIDER=mock
# 告警推送：钉钉或企业微信群机器人的 Webhook 地址（含令牌，不进仓库）；不配时告警只写 ERROR 日志
ALERT_WEBHOOK_URL=
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
# 支付（T25，ADR 0011）：mock 只在非生产环境可用，本地用 POST /dev/pay/mock/{orderNo} 模拟支付成功；
# real 时只启用配了的渠道。私钥、公钥可以是 PEM（换行写成 \n）或去掉头尾的一行 base64。
PAY_PROVIDER=mock
PAY_NOTIFY_BASE_URL=https://training.dreamelab.cn/api/v1
WECHAT_PAY_APP_ID=
WECHAT_PAY_MCH_ID=
WECHAT_PAY_SERIAL_NO=
WECHAT_PAY_PRIVATE_KEY=
WECHAT_PAY_APIV3_KEY=
WECHAT_PAY_PLATFORM_PUBLIC_KEY=
WECHAT_PAY_PLATFORM_SERIAL=
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
APPLE_IAP_ISSUER_ID=
APPLE_IAP_KEY_ID=
APPLE_IAP_PRIVATE_KEY=
APPLE_IAP_BUNDLE_ID=cn.dreamelab.training
OSS_PROVIDER=mock
# 本地 mock OSS 的预签名地址前缀；真机调试填本机局域网地址，如 http://192.168.1.10:8080
OSS_MOCK_BASE_URL=
# 本地 mock OSS 的文件目录：API 与 Worker 是两个进程，靠它共享上传的资料；默认是系统临时目录下的 peetraining-mock-oss
OSS_MOCK_DIR=

# 导出题库 PDF 用的中文 TrueType 字体；镜像里在 /app/fonts（Dockerfile 安装），本地开发填系统里的路径，
# 例如 Debian / Ubuntu 安装 fonts-droid-fallback 后为 /usr/share/fonts/truetype/droid/DroidSansFallbackFull.ttf
EXPORT_FONT_PATH=
# 字母与数字用的西文字体，例如 fonts-dejavu-core 的 /usr/share/fonts/truetype/dejavu/DejaVuSans.ttf
EXPORT_LATIN_FONT_PATH=
