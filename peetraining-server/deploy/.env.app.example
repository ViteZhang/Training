# 应用机 /opt/training/.env 示例（只放占位值；真实值在服务器上填，不进仓库）
IMAGE=registry.cn-beijing.aliyuncs.com/<命名空间>/peetraining-server
VERSION=v0.1.0
# 国内拉不到 docker.io 时改成 ACR 里同步的镜像
# NGINX_IMAGE=registry.cn-beijing.aliyuncs.com/<命名空间>/nginx:1.27-alpine
# ASYNQMON_IMAGE=registry.cn-beijing.aliyuncs.com/<命名空间>/asynqmon:latest

APP_ENV=production
HTTP_ADDR=:8080
SHUTDOWN_TIMEOUT=30s
MYSQL_DSN=training:<密码>@tcp(<数据库机内网 IP>:3306)/training
REDIS_ADDR=<数据库机内网 IP>:6379
REDIS_PASSWORD=<密码>
JWT_SECRET=<至少 32 个字符的随机串>
OSS_ENDPOINT=oss-cn-beijing-internal.aliyuncs.com
OSS_BUCKET=<私有桶>
OSS_ACCESS_KEY_ID=<RAM 子账号>
OSS_ACCESS_KEY_SECRET=<RAM 子账号>
# 阿里云短信（凭证用下面的 ALIYUN_ACCESS_KEY_*，RAM 子账号需有 AliyunDysmsFullAccess 或 dysms:SendSms 权限）
SMS_PROVIDER=aliyun
SMS_SIGN_NAME=<审核通过的签名，如 考研Training>
SMS_TEMPLATE_CODE=<审核通过的验证码模板，如 SMS_123456789>
# 模板里验证码的变量名，模板是 ${code} 时不用改
SMS_TEMPLATE_PARAM=code
AI_PROVIDER=bailian
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BAILIAN_API_KEY=<key>
# OCR、语音、内容安全的阿里云实现还没有接入，填 aliyun 会导致 api 与 worker 启动失败；接入前保持 mock。
# （扫描版 PDF、语音作答的功能开关默认关闭，不受影响）
OCR_PROVIDER=mock
ASR_PROVIDER=mock
MODERATION_PROVIDER=mock
ALIYUN_ACCESS_KEY_ID=<RAM 子账号>
ALIYUN_ACCESS_KEY_SECRET=<RAM 子账号>
PAY_PROVIDER=mock
