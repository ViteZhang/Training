# 本地 API 直接连接 ECS 上的 MySQL 和 Redis，使用独立 training_dev 库。
# 复制为 .env.local，替换占位值后执行 chmod 600 .env.local。
APP_ENV=local
HTTP_ADDR=127.0.0.1:8080
SHUTDOWN_TIMEOUT=30s

# 填写 ECS 的公网 IP 或可达域名；不要填写 dreamer_ai 库。
MYSQL_DSN='training_dev:CHANGE_ME@tcp(154.9.254.163:3306)/training_dev?charset=utf8mb4&parseTime=true&loc=UTC'
REDIS_ADDR=154.9.254.163:6379
REDIS_PASSWORD=CHANGE_ME
REDIS_DB=2

# 直连模式要求 ECS 安全组只允许你的办公公网 IP 访问 3306 和 6379。

# 本地环境的云服务默认使用 mock；确有需要时再填写非生产环境的覆盖配置。
SMS_PROVIDER=mock
AI_PROVIDER=mock
OCR_PROVIDER=mock
ASR_PROVIDER=mock
MODERATION_PROVIDER=mock
PAY_PROVIDER=mock
OSS_PROVIDER=mock

# 官方教材向量化：仅后端 API/Worker 使用，密钥填写本机 .env.local，禁止提交。
# 启用前设置 provider=openai；默认 disabled，缺服务不能完成索引或发布。
TEXTBOOK_EMBEDDING_PROVIDER=disabled
TEXTBOOK_EMBEDDING_BASE_URL=https://llm-fr3l8h9861g95r7x.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
TEXTBOOK_EMBEDDING_API_KEY=
TEXTBOOK_EMBEDDING_MODEL=qwen3.7-text-embedding-flash
TEXTBOOK_EMBEDDING_DIMENSIONS=1024
# Qdrant 私有服务地址；独立 API key（不是大模型密钥）。不要向客户端公开。
TEXTBOOK_VECTOR_URL=
TEXTBOOK_VECTOR_API_KEY=
