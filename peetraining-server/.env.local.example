# 本机大模型配置模板：复制为 .env.local（cp .env.local.example .env.local），只改密钥那一行。
# .env.local 不会提交进仓库；make dev 与 make ai-check 启动前会自动读取它。

# ── 方式 A：阿里云百炼（通义千问）──
AI_PROVIDER=bailian
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BAILIAN_API_KEY=把这里换成你的百炼密钥
AI_MODEL_STRONG=qwen-max
AI_MODEL_CHEAP=qwen-plus

# ── 方式 B：OpenAI 兼容的中转接口（用它时把上面的 AI_PROVIDER 改成 relay，再去掉下面几行的 #）──
# AI_RELAY_BASE_URL=https://中转地址/v1
# AI_RELAY_API_KEY=把这里换成你的中转密钥
# AI_RELAY_MODEL_STRONG=模型名
# AI_RELAY_MODEL_CHEAP=模型名

# 所有能力都用高阶模型（效果好、更贵）；想省钱改成 false
AI_PREFER_STRONG=true
