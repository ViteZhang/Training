# 生产应用配置模板（本文件可提交仓库；真实 .env 只放 ECS 的 /opt/training/.env）
# 首次使用：cp deploy/.env.app.example /opt/training/.env，然后逐项替换 CHANGE_ME。
#
# 上线阻塞说明：当前代码还没有接入生产短信、OSS、OCR、ASR、内容安全 provider。
# SMS_PROVIDER=aliyun 当前会报“未知或尚未实现的服务商”，SMS_PROVIDER=mock 在 production 会被拒绝。
# 因此在这些 provider 实现并通过生产验证前，不要运行正式部署流水线。

# 云效构建成功后同步到应用机；命名空间改成你的 ACR 命名空间。
IMAGE=registry.cn-beijing.aliyuncs.com/CHANGE_ME/peetraining-server
# 首次部署时填写 bootstrap；release.sh 会自动更新为正在发布的 tag/提交号。
# 后续部署会自动记录上一版本用于回滚，不要使用 latest。
VERSION=bootstrap
# 可选：把 asynqmon 镜像同步到自己的 ACR 后再填写。
# ASYNQMON_IMAGE=registry.cn-beijing.aliyuncs.com/CHANGE_ME/asynqmon:latest

# ---------- 服务运行必填 ----------
APP_ENV=production
HTTP_ADDR=:8080
SHUTDOWN_TIMEOUT=30s

# 使用 ECS 上 training 专用账号和 training 库；容器名必须能在 dreamer-net 网络解析。
# 密码建议用 openssl rand -hex 24 生成，避免 DSN 分隔符造成解析问题。
MYSQL_DSN=training:CHANGE_ME@tcp(dreamer-mysql:3306)/training?charset=utf8mb4&parseTime=true&loc=UTC
# 与项目 API、Worker、asynqmon 共用 Redis 1 号库；确认未被其他业务占用。
REDIS_ADDR=dreamer-redis:6379
REDIS_PASSWORD=CHANGE_ME
REDIS_DB=1
# openssl rand -hex 32 生成；只用于生产，至少 32 字符。
JWT_SECRET=CHANGE_ME

# ---------- 发布前数据库备份必填 ----------
# 独立的 MySQL 备份账号；不要复用 training 应用账号。
BACKUP_MYSQL_DSN=backup:CHANGE_ME@tcp(dreamer-mysql:3306)/training
# backup-mysql.sh 上传到此 OSS 桶；ECS 需预先安装并配置有写权限的 ossutil。
BACKUP_OSS_BUCKET=CHANGE_ME
BACKUP_DOCKER_NETWORK=dreamer-net
BACKUP_MYSQL_IMAGE=mysql:8.4

# ---------- 已接入或待接入的外部服务 ----------
# 百炼客户端已接入。需要 AI 功能时填写真实 Key；不需要 AI 时可改 mock（只适用于测试）。
AI_PROVIDER=bailian
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BAILIAN_API_KEY=CHANGE_ME
AI_MODEL_STRONG=qwen-max
AI_MODEL_CHEAP=qwen-plus
AI_PREFER_STRONG=true
# 可选备用/对照模型：需要时再填，不配时留空。
AI_ALT_BASE_URL=
AI_ALT_API_KEY=
AI_RELAY_BASE_URL=
AI_RELAY_API_KEY=
AI_RELAY_MODEL_STRONG=gpt-5.5
AI_RELAY_MODEL_CHEAP=gpt-5.5
# 可选，按“模型=输入价:输出价”填写，单位元/百万 token。
AI_PRICES=

# 以下 provider 与凭据是生产目标配置；当前代码还未接入这些真实服务，照此填写会在启动时明确报错。
# SMS 是后台与用户登录必需能力；当前 main 分支只有 mock，且 production 禁止 mock。
SMS_PROVIDER=aliyun
SMS_SIGN_NAME=CHANGE_ME
SMS_TEMPLATE_CODE=CHANGE_ME
# OSS 上传、OCR、语音识别、内容审核当前尚无真实 provider 接线。
OSS_PROVIDER=aliyun
OSS_ENDPOINT=oss-cn-beijing-internal.aliyuncs.com
OSS_BUCKET=CHANGE_ME
OSS_ACCESS_KEY_ID=CHANGE_ME
OSS_ACCESS_KEY_SECRET=CHANGE_ME
OCR_PROVIDER=aliyun
ASR_PROVIDER=aliyun
MODERATION_PROVIDER=aliyun
ALIYUN_ACCESS_KEY_ID=CHANGE_ME
ALIYUN_ACCESS_KEY_SECRET=CHANGE_ME
# 支付目前可使用已接入渠道；设置 real 后只配置你已经开通的渠道完整凭据。
# 当前不开放支付时保持 mock（production 不会创建 mock 支付网关）。
PAY_PROVIDER=mock
PAY_NOTIFY_BASE_URL=https://training.dreamelab.cn/api/v1
# 微信支付（条件项）
WECHAT_PAY_APP_ID=
WECHAT_PAY_MCH_ID=
WECHAT_PAY_SERIAL_NO=
WECHAT_PAY_PRIVATE_KEY=
WECHAT_PAY_APIV3_KEY=
WECHAT_PAY_PLATFORM_PUBLIC_KEY=
WECHAT_PAY_PLATFORM_SERIAL=
# 支付宝（条件项）
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
# Apple IAP（条件项）
APPLE_IAP_ISSUER_ID=
APPLE_IAP_KEY_ID=
APPLE_IAP_PRIVATE_KEY=
APPLE_BUNDLE_ID=cn.dreamelab.training

# 可选告警机器人地址；未配置时告警只写应用日志。
ALERT_WEBHOOK_URL=
