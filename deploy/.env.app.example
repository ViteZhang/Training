# 生产应用配置模板（本文件可提交仓库；真实 .env 只放 ECS 的 /opt/dreamer/project/training/.env）
# 首次使用：cp deploy/.env.app.example /opt/dreamer/project/training/.env，然后填写必填配置和已启用能力的凭据。
#
# 当前未接入阿里云短信、OSS、OCR、ASR、内容安全，先用 disabled 显式关闭，允许部署并验证健康接口。
# 关闭后相关业务不可用，包括短信登录、文件上传及依赖审核的 AI 功能；不会返回 mock 成功结果。
# 只有补齐真实 provider 实现并验证后才能开放完整业务，不能仅将 provider 改成 aliyun。

# 只填写镜像仓库地址，不要带 :latest、:v1.0 等标签；Compose 会自动追加 :latest。
IMAGE=crpi-3mjxc296umgnl4w9.cn-beijing.personal.cr.aliyuncs.com/dreamer-lab/peetraining-server
# 云效每次把镜像推送为 latest；docker-compose.yml 配置为每次 up 都拉取。
# 可选：把 asynqmon 镜像同步到自己的 ACR 后再填写。
# ASYNQMON_IMAGE=registry.cn-beijing.aliyuncs.com/CHANGE_ME/asynqmon:latest

# ---------- 服务运行必填 ----------
APP_ENV=production
HTTP_ADDR=:8080
SHUTDOWN_TIMEOUT=30s

# 使用 ECS 上 training 专用账号和 training 库；容器名必须能在 dreamer-net 网络解析。
# 密码建议用 openssl rand -hex 24 生成，避免 DSN 分隔符造成解析问题。
MYSQL_DSN=training:CHANGE_ME@tcp(dreamer-mysql:3306)/training?charset=utf8mb4&parseTime=true&loc=UTC
# 与项目 API、Worker、asynqmon 共用 Redis 1 号库；确认未被其他业务占用。
REDIS_ADDR=dreamer-redis:6379
REDIS_PASSWORD=CHANGE_ME
REDIS_DB=1
# openssl rand -hex 32 生成；只用于生产，至少 32 字符。
JWT_SECRET=CHANGE_ME

# ---------- 已接入或待接入的外部服务 ----------
# 百炼客户端已接入。需要 AI 功能时填写真实 Key；不需要 AI 时可改 mock（只适用于测试）。
AI_PROVIDER=bailian
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BAILIAN_API_KEY=CHANGE_ME
AI_MODEL_STRONG=qwen-max
AI_MODEL_CHEAP=qwen-plus
AI_PREFER_STRONG=true
# 可选备用/对照模型：需要时再填，不配时留空。
AI_ALT_BASE_URL=
AI_ALT_API_KEY=
AI_RELAY_BASE_URL=
AI_RELAY_API_KEY=
AI_RELAY_MODEL_STRONG=gpt-5.5
AI_RELAY_MODEL_CHEAP=gpt-5.5
# 可选，按“模型=输入价:输出价”填写，单位元/百万 token。
AI_PRICES=

# 阿里云短信已接入（登录验证码）：凭证用下面的 ALIYUN_ACCESS_KEY_ID / SECRET，RAM 子账号需有短信发送权限；
# 签名与模板须在阿里云短信控制台审核通过。production 不允许用 mock 短信代替真实发送；disabled 时无法登录。
SMS_PROVIDER=aliyun
SMS_SIGN_NAME=CHANGE_ME
SMS_TEMPLATE_CODE=CHANGE_ME
# 模板里验证码的变量名，模板是 ${code} 时不用改
SMS_TEMPLATE_PARAM=code

# 暂未接入的服务使用 disabled。
OSS_PROVIDER=disabled
OSS_ENDPOINT=oss-cn-beijing-internal.aliyuncs.com
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OCR_PROVIDER=disabled
ASR_PROVIDER=disabled
MODERATION_PROVIDER=disabled
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
# 支付目前可使用已接入渠道；设置 real 后只配置你已经开通的渠道完整凭据。
# 暂不开放支付时使用 disabled，不会读取占位支付密钥或创建 mock 支付网关。
PAY_PROVIDER=disabled
PAY_NOTIFY_BASE_URL=https://training.dreamerlab.cn/api/v1
# 微信支付（PAY_PROVIDER=real 且启用微信时填写完整配置）
# PRIVATE_KEY 填商户 API 私钥内容，不是文件路径或证书；PEM 可用单引号保留字面量 \n：
# WECHAT_PAY_PRIVATE_KEY='-----BEGIN PRIVATE KEY-----\n真实私钥主体\n-----END PRIVATE KEY-----'
# 未开通时以下值留空，不要填写 CHANGE_ME。
WECHAT_PAY_APP_ID=
WECHAT_PAY_MCH_ID=
WECHAT_PAY_SERIAL_NO=
WECHAT_PAY_PRIVATE_KEY=
WECHAT_PAY_APIV3_KEY=
WECHAT_PAY_PLATFORM_PUBLIC_KEY=
WECHAT_PAY_PLATFORM_SERIAL=
# 支付宝（条件项）
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
# Apple IAP（条件项）
APPLE_IAP_ISSUER_ID=
APPLE_IAP_KEY_ID=
APPLE_IAP_PRIVATE_KEY=
APPLE_BUNDLE_ID=cn.dreamelab.training

# 可选告警机器人地址；未配置时告警只写应用日志。
ALERT_WEBHOOK_URL=
