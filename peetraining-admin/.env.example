# 应用机 /opt/dreamer/project/training-admin/.env
# ACR 个人版镜像地址，不含标签；标签由 ADMIN_TAG 控制。
# 例：crpi-xxxxxxxxxxxx.cn-beijing.personal.cr.aliyuncs.com/<命名空间>/peetraining-admin
ADMIN_IMAGE=crpi-3mjxc296umgnl4w9.cn-beijing.personal.cr.aliyuncs.com/dreamer-lab/peetraining-server
# latest 或某个提交 SHA；回滚时改成上一个 SHA。
ADMIN_TAG=latest
