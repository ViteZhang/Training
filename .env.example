# 环境变量示例：只放占位值，真实值不进仓库。本地不设置任何变量也能启动（全部走 mock）。
APP_ENV=local
HTTP_ADDR=:8080
SHUTDOWN_TIMEOUT=30s
MYSQL_DSN=training:training@tcp(127.0.0.1:3306)/training
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0
# 生产必须设置，至少 32 个字符
JWT_SECRET=

OSS_ENDPOINT=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

# 云服务：mock 或真实服务商（真实实现在对应任务卡里加）
SMS_PROVIDER=mock
SMS_SIGN_NAME=
SMS_TEMPLATE_CODE=
AI_PROVIDER=mock
BAILIAN_BASE_URL=
BAILIAN_API_KEY=
AI_ALT_BASE_URL=
AI_ALT_API_KEY=
OCR_PROVIDER=mock
ASR_PROVIDER=mock
MODERATION_PROVIDER=mock
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
PAY_PROVIDER=mock
OSS_PROVIDER=mock
