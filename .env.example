# 环境变量示例：只放占位值，真实值不进仓库。本地不设置任何变量也能启动（全部走 mock）。
APP_ENV=local
HTTP_ADDR=:8080
SHUTDOWN_TIMEOUT=30s
MYSQL_DSN=training:training@tcp(127.0.0.1:3306)/training
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0
# 生产必须设置，至少 32 个字符
JWT_SECRET=

# OSS：OSS_PROVIDER 在文件末尾（mock / aliyun / disabled）。
# OSS_ENDPOINT 填公网地址（App 直传与下载用）；同地域 ECS 上再填 OSS_INTERNAL_ENDPOINT，服务端读写走内网。
# 只填了内网地址时，程序自动把预签名地址换成对应的公网地址。AccessKey 不填时复用 ALIYUN_ACCESS_KEY_ID / SECRET。
OSS_ENDPOINT=
OSS_INTERNAL_ENDPOINT=
OSS_REGION=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

# 云服务：mock 或真实服务商（真实实现在对应任务卡里加）
# 短信：mock（本地，验证码打印在日志里）或 aliyun（阿里云短信，生产必须用 aliyun）。
# aliyun 时凭证用下面的 ALIYUN_ACCESS_KEY_ID / SECRET，签名与模板须在阿里云短信控制台审核通过。
SMS_PROVIDER=mock
SMS_SIGN_NAME=
SMS_TEMPLATE_CODE=
# 验证码模板里的变量名：模板写「验证码为：${code}」时填 code（默认）
SMS_TEMPLATE_PARAM=code
# 国内短信接口地址（默认值即可）
SMS_ENDPOINT=dysmsapi.aliyuncs.com
# 测试账号：逗号分隔的手机号，获取验证码时不发短信，验证码固定 000000，不占每日次数（仍有 60 秒冷却）。
# 不填时默认 18600010001～18600010010；填 off 关闭。
SMS_TEST_PHONES=
# mock / bailian / relay（relay：OpenAI 兼容的中转接口为主，配了百炼时中转出错自动改用百炼）
AI_PROVIDER=mock
BAILIAN_BASE_URL=
BAILIAN_API_KEY=
AI_ALT_BASE_URL=
AI_ALT_API_KEY=
# 百炼两档模型的默认名（主用模型待 T31 评测后定）
AI_MODEL_STRONG=qwen3.8-flash
AI_MODEL_CHEAP=qwen3.8-flash
AI_BAILIAN_THINKING=false
# 优先用高阶模型：便宜档能力也用 STRONG（省钱时设为 false）
AI_PREFER_STRONG=true
AI_RELAY_BASE_URL=
AI_RELAY_API_KEY=
AI_RELAY_MODEL_STRONG=gpt-5.5
AI_RELAY_MODEL_CHEAP=gpt-5.5
# 模型价格，元 / 百万 token（输入:输出），按平台当时的公开价填写；不填则成本记为 0（7.8 成本看板与评测的每千次成本都依赖它）
AI_PRICES=
# 文字识别：mock / aliyun / disabled（aliyun：通用文字识别高精版 + 手写体识别，默认地址 ocr-api.cn-hangzhou.aliyuncs.com）
OCR_PROVIDER=mock
OCR_ENDPOINT=
# PDF 解析：mock / pdfium（内嵌 PDFium 取文字层，扫描页交给 OCR）/ disabled；不填时跟随 OCR_PROVIDER（aliyun→pdfium）
PDF_PROVIDER=
ASR_PROVIDER=mock
# 内容安全：mock / aliyun / disabled（aliyun：内容安全增强版，默认 green-cip.cn-beijing.aliyuncs.com）
MODERATION_PROVIDER=mock
MODERATION_ENDPOINT=
# 文本服务默认 comment_detection_pro，图片服务默认 baselineCheck；可在内容安全控制台调整各服务的检测规则
MODERATION_TEXT_SERVICE=
MODERATION_IMAGE_SERVICE=
# 判为不通过的最低风险等级：high（默认）/ medium / low
MODERATION_REJECT_LEVEL=
# 告警推送：钉钉或企业微信群机器人的 Webhook 地址（含令牌，不进仓库）；不配时告警只写 ERROR 日志
ALERT_WEBHOOK_URL=
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
# 支付（T25，ADR 0011）：mock 只在非生产环境可用，本地用 POST /dev/pay/mock/{orderNo} 模拟支付成功；
# real 时只启用配了的渠道。私钥、公钥可以是 PEM（换行写成 \n）或去掉头尾的一行 base64。
PAY_PROVIDER=mock
PAY_NOTIFY_BASE_URL=https://training.dreamerlab.cn/api/v1
WECHAT_PAY_APP_ID=
WECHAT_PAY_MCH_ID=
WECHAT_PAY_SERIAL_NO=
WECHAT_PAY_PRIVATE_KEY=
WECHAT_PAY_APIV3_KEY=
WECHAT_PAY_PLATFORM_PUBLIC_KEY=
WECHAT_PAY_PLATFORM_SERIAL=
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
APPLE_IAP_ISSUER_ID=
APPLE_IAP_KEY_ID=
APPLE_IAP_PRIVATE_KEY=
APPLE_IAP_BUNDLE_ID=cn.dreamerlab.training
OSS_PROVIDER=mock
# 本地 mock OSS 的预签名地址前缀；真机调试填本机局域网地址，如 http://192.168.1.10:8080
OSS_MOCK_BASE_URL=

# 导出题库 PDF 用的中文 TrueType 字体；镜像里在 /app/fonts（Dockerfile 安装），本地开发填系统里的路径，
# 例如 Debian / Ubuntu 安装 fonts-droid-fallback 后为 /usr/share/fonts/truetype/droid/DroidSansFallbackFull.ttf
EXPORT_FONT_PATH=
# 字母与数字用的西文字体，例如 fonts-dejavu-core 的 /usr/share/fonts/truetype/dejavu/DejaVuSans.ttf
EXPORT_LATIN_FONT_PATH=
